{
  "name": "jupiter-synthesizer",
  "productName": "Jupiter Synthesizer",
  "version": "1.0.0",
  "description": "Jupiter-8 Synthesizer with Direct Native ASIO 2.0 and Multi-Channel Output",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:dir": "electron-builder --win --dir",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build": "electron-builder --win"
  },
  "keywords": [
    "synth",
    "asio",
    "jupiter-8",
    "low-latency"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jupiter8.synthhost",
    "productName": "Jupiter Synthesizer",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jupiter Synthesizer"
    },
    "extraResources": [
      {
        "from": "asio-bridge",
        "to": "asio-bridge",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "asio-bridge/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
